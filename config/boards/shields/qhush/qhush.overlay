#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <dt-bindings/led/led.h>

/ {
    /* システム全体への指示 */
    chosen {
        zmk,physical-layout = &default_layout;
        zmk,underglow = &led_strip;
        zmk,matrix-transform = &default_transform;
        
        /* ZMK Studioのバリデーションを確実にパスさせるストレージ宣言 */
        zmk,studio-storage = &studio_storage;
    };

    /* 最新ZMK Studioが必須とするストレージノードの完全な定義 */
    studio_storage: studio_storage {
        compatible = "zmk,studio-storage";
    };

    vbatt: vbatt {
        status = "disabled";
    };

    /* 5x5 マトリックス変換 */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <5>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)
        >;
    };

    /* ZMK Studio用レイアウト物理座標定義 */
    physical_layouts {
        compatible = "zmk,physical-layouts";
        default_layout: default_layout {
            compatible = "zmk,physical-layout";
            display-name = "Default Layout";
            transform = <&default_transform>;
            kscan = <&kscan0>;
            
            keys
                = <&key_physical_attrs 100 100   0   0 0 0 0>, <&key_physical_attrs 100 100 100   0 0 0 0>, <&key_physical_attrs 100 100 200   0 0 0 0>, <&key_physical_attrs 100 100 300   0 0 0 0>, <&key_physical_attrs 100 100 400   0 0 0 0>
                , <&key_physical_attrs 100 100   0 100 0 0 0>, <&key_physical_attrs 100 100 100 100 0 0 0>, <&key_physical_attrs 100 100 200 100 0 0 0>, <&key_physical_attrs 100 100 300 100 0 0 0>, <&key_physical_attrs 100 100 400 100 0 0 0>
                , <&key_physical_attrs 100 100   0 200 0 0 0>, <&key_physical_attrs 100 100 100 200 0 0 0>, <&key_physical_attrs 100 100 200 200 0 0 0>, <&key_physical_attrs 100 100 300 200 0 0 0>, <&key_physical_attrs 100 100 400 200 0 0 0>
                , <&key_physical_attrs 100 100   0 300 0 0 0>, <&key_physical_attrs 100 100 100 300 0 0 0>, <&key_physical_attrs 100 100 200 300 0 0 0>, <&key_physical_attrs 100 100 300 300 0 0 0>, <&key_physical_attrs 100 100 400 300 0 0 0>
                , <&key_physical_attrs 100 100   0 400 0 0 0>, <&key_physical_attrs 100 100 100 400 0 0 0>, <&key_physical_attrs 100 100 200 400 0 0 0>, <&key_physical_attrs 100 100 300 400 0 0 0>, <&key_physical_attrs 100 100 400 400 0 0 0>
                ;
        };
    };

    /* キースイッチ配線設定 */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        col-gpios
            = <&xiao_d 10 GPIO_ACTIVE_HIGH> // Col0 (P1.14 = D9) ZMK規則の10を指定
            , <&xiao_d  7 GPIO_ACTIVE_HIGH> // Col1 (P1.12 = D7)
            , <&xiao_d  6 GPIO_ACTIVE_HIGH> // Col2 (P1.11 = D6)
            , <&xiao_d  0 GPIO_ACTIVE_HIGH> // Col3 (P0.02 = D0)
            , <&xiao_d  1 GPIO_ACTIVE_HIGH> // Col4 (P0.03 = D1)
            ;

        row-gpios
            = <&xiao_d  5 GPIO_ACTIVE_HIGH> // Row0 (P0.05 = D5)
            , <&xiao_d  8 GPIO_ACTIVE_HIGH> // Row1 (P1.13 = D8)
            , <&xiao_d  4 GPIO_ACTIVE_HIGH> // Row2 (P0.04 = D4)
            , <&xiao_d  3 GPIO_ACTIVE_HIGH> // Row3 (P0.29 = D3)
            , <&xiao_d  2 GPIO_ACTIVE_HIGH> // Row4 (P0.28 = D2)
            ;
    };
};

/* 未使用ペリフェラルの解放 */
&i2c0 { status = "disabled"; };
&i2c1 { status = "disabled"; };
&spi2 { status = "disabled"; };
&spi3 { status = "disabled"; };
&uart0 { status = "disabled"; };

/* Underglow LED設定 (干渉を避けるためSPI1を使用) */
&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 15)>; // D10 (P1.15)
        };
    };
    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 15)>;
            low-power-enable;
        };
    };
};

&spi1 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default","sleep";
    
    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        chain-length = <4>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};